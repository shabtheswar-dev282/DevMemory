<mxfile host="app.diagrams.net"><diagram id="arch" name="Three-layer architecture"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;DevMemory: three-layer architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5E6A77&quot;&gt;Conflict-aware, multi-writer project memory for AI coding agents. Prototype plan, October 2026.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1B2A3A;" vertex="1" parent="1"><mxGeometry x="0" y="-72" width="1100" height="56" as="geometry"/></mxCell><mxCell id="laneP" value="&lt;b&gt;PRESENTATION LAYER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;what developers and&lt;br&gt;agents interact with&lt;/font&gt;" style="swimlane;horizontal=0;startSize=120;html=1;fontSize=13;fontColor=#23466B;fillColor=#EEF3F8;strokeColor=#9DB6CF;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="170" as="geometry"/></mxCell><mxCell id="laneF" value="&lt;b&gt;FUNCTIONALITY LAYER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;application logic&lt;br&gt;TypeScript on Node.js 24&lt;br&gt;(embeddings in Python)&lt;/font&gt;" style="swimlane;horizontal=0;startSize=120;html=1;fontSize=13;fontColor=#23466B;fillColor=#F6F8FA;strokeColor=#C9D1DA;" vertex="1" parent="1"><mxGeometry x="0" y="170" width="1600" height="445" as="geometry"/></mxCell><mxCell id="laneD" value="&lt;b&gt;DATABASE LAYER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;PostgreSQL 16&lt;br&gt;in Docker Compose&lt;/font&gt;" style="swimlane;horizontal=0;startSize=120;html=1;fontSize=13;fontColor=#23466B;fillColor=#F7F4EC;strokeColor=#D9C08A;" vertex="1" parent="1"><mxGeometry x="0" y="615" width="1600" height="180" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;AI coding agent, vendor 1&lt;br&gt;MCP client · actor: claude-code&lt;br&gt;&lt;font color=&quot;#F2E6C9&quot;&gt;&lt;b&gt;PP demo&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#23466B;strokeColor=#23466B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="laneP"><mxGeometry x="140" y="35" width="200" height="100" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Cursor&lt;/b&gt;&lt;br&gt;AI coding agent, vendor 2&lt;br&gt;MCP client · actor: cursor&lt;br&gt;&lt;font color=&quot;#F2E6C9&quot;&gt;&lt;b&gt;PP demo&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#4B5866;strokeColor=#4B5866;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="laneP"><mxGeometry x="370" y="35" width="200" height="100" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Scripted MCP client&lt;/b&gt;&lt;br&gt;replays seeded two-agent histories deterministically" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneP"><mxGeometry x="600" y="35" width="200" height="100" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Benchmark CLI&lt;/b&gt;&lt;br&gt;runs C0 to C3 and ablation A1; exports results to Python analysis (Wilson intervals, kappa, figures)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneP"><mxGeometry x="1010" y="35" width="200" height="100" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;Read-only dashboard&lt;/b&gt;&lt;br&gt;React + Vite · conflicts, each policy's outcome, provenance, benchmark metrics · WCAG 2.2 AA&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo: conflicts page&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneP"><mxGeometry x="1300" y="35" width="250" height="100" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;MCP server&lt;/b&gt;&lt;br&gt;stdio · MCP SDK 1.32 · 8 memory tools (record decision, report/resolve bug, add/complete TODO, add note, search, get project memory) · &lt;i&gt;new:&lt;/i&gt; tags every write with actor, session and time; list_conflicts tool&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAEDF0;strokeColor=#A9B4BF;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="140" y="25" width="660" height="95" as="geometry"/></mxCell><mxCell id="f9" value="&lt;b&gt;Benchmark harness&lt;/b&gt;&lt;br&gt;seeded histories with injected conflicts and repeat failures; scores P/R/F1, agreement, failures prevented, latency, tokens" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="1010" y="25" width="200" height="95" as="geometry"/></mxCell><mxCell id="f8" value="&lt;b&gt;Dashboard API&lt;/b&gt;&lt;br&gt;read-only HTTP · serves conflicts, outcomes, provenance and metrics&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="1300" y="25" width="250" height="95" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;Secret redaction&lt;/b&gt;&lt;br&gt;removes keys, tokens and passwords before storage; on by default" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="140" y="200" width="200" height="110" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;Memory service + projector&lt;/b&gt;&lt;br&gt;appends events; current project state is a pure function of the log&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAEDF0;strokeColor=#A9B4BF;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="370" y="200" width="200" height="110" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;Conflict detection&lt;/b&gt;&lt;br&gt;runs on every new event: candidate pairs from type-aware heuristics, semantic similarity and the component graph; classify: contradiction / refinement / unrelated&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo: candidate flag&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="600" y="195" width="260" height="125" as="geometry"/></mxCell><mxCell id="f5" value="&lt;b&gt;Resolution policies&lt;/b&gt;&lt;br&gt;applied to each candidate conflict; one interface: last-write-wins · recency-weighted · flag-for-review · LLM-as-judge&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo: flag-for-review&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="890" y="195" width="200" height="125" as="geometry"/></mxCell><mxCell id="f6" value="&lt;b&gt;Embedding service&lt;/b&gt;&lt;br&gt;Python · Sentence-Transformers all-MiniLM-L6-v2, local; a &quot;same subject&quot; signal only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="600" y="350" width="190" height="80" as="geometry"/></mxCell><mxCell id="f7" value="&lt;b&gt;Component graph builder&lt;/b&gt;&lt;br&gt;event to file to component, from Git commit file paths&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo: folder mapping&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="laneF"><mxGeometry x="820" y="350" width="210" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;projects&lt;/b&gt;&lt;br&gt;one row per project" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fontSize=11;fillColor=#EAEDF0;strokeColor=#A9B4BF;fontColor=#1B2A3A;" vertex="1" parent="laneD"><mxGeometry x="140" y="40" width="190" height="100" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;memory_events&lt;/b&gt;&lt;br&gt;append-only log with actor and time; decision, bug, TODO and note events · &lt;i&gt;new:&lt;/i&gt; session, conflict and resolution events&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fontSize=11;fillColor=#EAEDF0;strokeColor=#A9B4BF;fontColor=#1B2A3A;" vertex="1" parent="laneD"><mxGeometry x="360" y="20" width="230" height="140" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;embedding cache&lt;/b&gt;&lt;br&gt;vectors per event and model" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fontSize=11;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;" vertex="1" parent="laneD"><mxGeometry x="610" y="40" width="170" height="100" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;component graph&lt;/b&gt;&lt;br&gt;edge table: event to file, file to component" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fontSize=11;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;" vertex="1" parent="laneD"><mxGeometry x="835" y="40" width="180" height="100" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;benchmark results&lt;/b&gt;&lt;br&gt;runs, metrics, LLM response cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fontSize=11;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;" vertex="1" parent="laneD"><mxGeometry x="1025" y="40" width="170" height="100" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;conflict view&lt;/b&gt;&lt;br&gt;read model rebuilt from the log: pairs, signals, class, each policy's outcome&lt;br&gt;&lt;font color=&quot;#8C6A2A&quot;&gt;&lt;b&gt;PP demo&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fontSize=11;fillColor=#FFFFFF;strokeColor=#A67C2E;dashed=1;strokeWidth=1.5;fontColor=#1B2A3A;" vertex="1" parent="laneD"><mxGeometry x="1300" y="20" width="250" height="140" as="geometry"/></mxCell><mxCell id="xt" value="&lt;b&gt;EXTERNAL&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5E6A77;" vertex="1" parent="1"><mxGeometry x="1660" y="340" width="200" height="30" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;LLM API&lt;/b&gt;&lt;br&gt;version-pinned Claude model, temperature 0, cached; judge policy only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="385" width="200" height="85" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;Git repositories&lt;/b&gt;&lt;br&gt;seeded (own or permissively licensed) and the author's own" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1B2A3A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="518" width=